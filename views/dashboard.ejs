<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Dashboard - Sistem Cuti FTI</title>

  <link rel="stylesheet" href="/style.css" />

  <style>
    * {
      box-sizing: border-box;
    }

    body {
        margin: 0;
        min-height: 100vh;
        font-family: Arial, Helvetica, sans-serif;
        color: #111827;
        background:
            radial-gradient(circle at top left, rgba(156, 163, 175, 0.25), transparent 32%),
            linear-gradient(135deg, #f8fafc, #eef2f7);
        overflow-x: hidden;
        overflow-y: auto;
    }

    .page {
        min-height: 100vh;
        padding: 28px 42px 48px;
        display: flex;
        flex-direction: column;
    }

    .topbar {
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 28px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand img {
      width: 56px;
      height: 56px;
      object-fit: contain;
    }

    .brand strong {
      display: block;
      font-size: 21px;
      font-weight: 800;
      color: #1f2937;
      line-height: 1.2;
    }

    .brand span {
      display: block;
      margin-top: 3px;
      font-size: 13px;
      color: #6b7280;
      font-weight: 600;
    }

    .user-area {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .user-pill {
      padding: 10px 14px;
      border-radius: 999px;
      background: rgba(255,255,255,0.75);
      border: 1px solid #e5e7eb;
      font-size: 13px;
      font-weight: 700;
      color: #374151;
      box-shadow: 0 8px 20px rgba(15,23,42,0.04);
    }

    .logout-btn {
      height: 42px;
      padding: 0 18px;
      border-radius: 12px;
      background: #6b7280 !important;
      color: #ffffff !important;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: 0.2s ease;
    }

    .logout-btn:hover {
      background: #4b5563 !important;
      transform: translateY(-1px);
    }

    .hero {
      margin-bottom: 26px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 32px;
    }

    .hero-left {
      max-width: 760px;
    }

    .role-badge {
      display: inline-flex;
      padding: 8px 14px;
      border-radius: 999px;
      background: #e5e7eb;
      color: #374151;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      margin-bottom: 14px;
    }

    .hero h1 {
      margin: 0;
      font-size: 44px;
      line-height: 1.15;
      font-weight: 800;
      letter-spacing: -0.8px;
      color: #111827;
    }

    .hero p {
      margin: 10px 0 0;
      font-size: 15px;
      color: #6b7280;
      line-height: 1.7;
    }

    .summary {
      display: grid;
      grid-template-columns: repeat(3, 190px);
      gap: 14px;
    }

    .summary-card {
      padding: 18px;
      border-radius: 18px;
      border: 1px solid #e5e7eb;
      background: rgba(255,255,255,0.78);
      box-shadow: 0 12px 28px rgba(15,23,42,0.05);
    }

    .summary-card span {
      display: block;
      font-size: 12px;
      color: #6b7280;
      margin-bottom: 10px;
    }

    .summary-card strong {
      font-size: 28px;
      font-weight: 800;
      color: #111827;
    }

    .section-title {
      margin: 0 0 16px;
      font-size: 20px;
      font-weight: 800;
      color: #111827;
    }

    .feature-grid {
      flex: 1;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      min-height: 0;
    }

    .feature-card {
      position: relative;
      overflow: hidden;
      min-height: 190px;
      padding: 26px;
      border-radius: 26px;
      border: 1px solid rgba(209, 213, 219, 0.9);
      background: rgba(255,255,255,0.84);
      backdrop-filter: blur(14px);
      box-shadow:
        0 12px 30px rgba(15,23,42,0.05),
        0 24px 60px rgba(15,23,42,0.04);
      transition: 0.25s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .feature-card::after {
      content: "";
      position: absolute;
      top: -40px;
      right: -40px;
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(156,163,175,0.22), transparent 70%);
    }

    .feature-card:hover {
      transform: translateY(-5px);
      box-shadow:
        0 18px 44px rgba(15,23,42,0.08),
        0 34px 80px rgba(15,23,42,0.08);
    }

    .feature-number {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      background: #eef2f7;
      color: #4b5563;
      font-size: 14px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
    }

    .feature-card h3 {
      margin: 0 0 10px;
      font-size: 21px;
      font-weight: 800;
      color: #111827;
      line-height: 1.3;
    }

    .feature-card p {
      margin: 0;
      color: #6b7280;
      font-size: 14px;
      line-height: 1.7;
    }

    .feature-footer {
      margin-top: 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .owner {
      font-size: 12px;
      color: #9ca3af;
      font-weight: 700;
    }

    .action-btn {
      border-radius: 12px;
      background: linear-gradient(135deg, #9ca3af, #6b7280) !important;
      color: #ffffff !important;
      font-size: 13px;
      font-weight: 800;
      padding: 10px 15px;
      text-decoration: none;
      transition: 0.2s ease;
      white-space: nowrap;
    }

    .action-btn:hover {
      background: linear-gradient(135deg, #717b89, #4b5563) !important;
      transform: translateY(-1px);
    }

    @media (max-width: 1100px) {
      body {
        overflow: auto;
      }

      .page {
        padding: 24px;
      }

      .hero {
        align-items: flex-start;
        flex-direction: column;
      }

      .summary {
        grid-template-columns: repeat(3, 1fr);
        width: 100%;
      }

      .feature-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 700px) {
      .topbar {
        height: auto;
        align-items: flex-start;
        flex-direction: column;
      }

      .user-area {
        width: 100%;
        justify-content: space-between;
      }

      .hero h1 {
        font-size: 34px;
      }

      .summary,
      .feature-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <%
    const roleList = roles.map(r => r.toLowerCase());

    const isAdmin = roleList.includes('admin');
    const isPegawai = roleList.includes('pegawai');
    const isAtasan = roleList.includes('atasan');
    const isAtasanLevel2 =
      roleList.includes('atasan level 2') ||
      roleList.includes('atasan_level_2') ||
      roleList.includes('atasan level2') ||
      roleList.includes('atasan_dari_atasan');

    let dashboardTitle = 'Dashboard';
    let dashboardDesc = 'Selamat datang di Sistem Informasi Cuti Pegawai Fakultas Teknologi Informasi.';
    let roleName = roles.join(', ') || 'Pengguna';

    let features = [];

    if (isPegawai) {
      dashboardTitle = 'Dashboard Pegawai';
      dashboardDesc = 'Ajukan cuti, pantau riwayat, dan kelola pengajuan cuti Anda dalam satu halaman.';
      features = [
        ['Buat Pengajuan Cuti', 'Pegawai dapat membuat pengajuan cuti baru sesuai kebutuhan.', 'Zizi Salsabila', 'Buka'],
        ['Riwayat Pengajuan Cuti', 'Pegawai dapat melihat riwayat pengajuan cuti yang pernah dibuat.', 'Zizi Salsabila', 'Buka'],
        ['Detail Pengajuan Cuti', 'Pegawai dapat melihat detail status dan informasi pengajuan cuti.', 'Zizi Salsabila', 'Buka'],
        ['Ubah Pengajuan Cuti', 'Pegawai dapat mengubah data pengajuan cuti tertentu.', 'Zizi Salsabila', 'Buka'],
        ['Hapus Pengajuan Cuti', 'Pegawai dapat menghapus pengajuan cuti yang masih memenuhi ketentuan.', 'Zizi Salsabila', 'Buka']
      ];
    } else if (isAtasanLevel2) {
      dashboardTitle = 'Dashboard Atasan Level 2';
      dashboardDesc = 'Kelola pengajuan cuti yang menunggu persetujuan akhir dari atasan level 2.';
      features = [
        ['Pengajuan Menunggu Persetujuan', 'Atasan Level 2 dapat melihat pengajuan cuti yang menunggu persetujuan.', 'Fazila Hassana Rahmat', 'Buka'],
        ['Setujui Pengajuan Cuti', 'Atasan Level 2 dapat menyetujui pengajuan cuti pegawai.', 'Fazila Hassana Rahmat', 'Setujui'],
        ['Tolak Pengajuan Cuti', 'Atasan Level 2 dapat menolak pengajuan cuti pegawai.', 'Fazila Hassana Rahmat', 'Tolak']
      ];
    } else if (isAtasan) {
      dashboardTitle = 'Dashboard Atasan';
      dashboardDesc = 'Pantau daftar pengajuan cuti pegawai, filter data, dan lihat detail pengajuan.';
      features = [
        ['Daftar Pengajuan Cuti Pegawai', 'Atasan dapat melihat daftar pengajuan cuti pegawai.', 'Fazila Hassana Rahmat', 'Buka'],
        ['Filter Daftar Pengajuan', 'Atasan dapat memfilter daftar pengajuan cuti berdasarkan kebutuhan.', 'Fazila Hassana Rahmat', 'Filter'],
        ['Detail Pengajuan Cuti Pegawai', 'Atasan dapat melihat detail pengajuan cuti pegawai.', 'Fazila Hassana Rahmat', 'Detail']
      ];
    } else if (isAdmin) {
      dashboardTitle = 'Dashboard Admin';
      dashboardDesc = 'Kelola rekapitulasi, filter laporan, dan ekspor data cuti pegawai.';
      features = [
        ['Rekapitulasi Data Cuti', 'Admin dapat melihat rekapitulasi data cuti pegawai.', 'Naufal Baihaqi Zachwan', 'Buka'],
        ['Filter Laporan Cuti', 'Admin dapat memfilter laporan cuti pegawai berdasarkan kebutuhan.', 'Naufal Baihaqi Zachwan', 'Filter'],
        ['Export Laporan PDF', 'Admin dapat mengekspor laporan cuti ke format PDF.', 'Naufal Baihaqi Zachwan', 'Export'],
        ['Export Laporan DOCX', 'Admin dapat mengekspor laporan cuti ke format DOCX.', 'Naufal Baihaqi Zachwan', 'Export']
      ];
    }
  %>

  <main class="page">
    <header class="topbar">
      <div class="brand">
        <img src="/images/logo-unand.jpg" alt="Logo FTI">
        <div>
          <strong>Fakultas Teknologi Informasi</strong>
          <span>Universitas Andalas</span>
        </div>
      </div>

      <div class="user-area">
        <div class="user-pill">
          <%= name %>
        </div>
        <a href="/auth/logout" class="btn logout-btn">Logout</a>
      </div>
    </header>

    <section class="hero">
      <div class="hero-left">
        <span class="role-badge"><%= roleName %></span>
        <h1><%= dashboardTitle %></h1>
        <p>Halo, <strong><%= name %></strong>. <%= dashboardDesc %></p>
      </div>

      <div class="summary">
        <div class="card summary-card">
          <span>Total Pengajuan</span>
          <strong>12</strong>
        </div>

        <div class="card summary-card">
          <span>Menunggu Proses</span>
          <strong>4</strong>
        </div>

        <div class="card summary-card">
          <span>Selesai</span>
          <strong>8</strong>
        </div>
      </div>
    </section>

    <h2 class="section-title">Fitur Tersedia</h2>

    <section class="feature-grid">
      <% features.forEach((feature, index) => { %>
        <div class="card feature-card">
          <div>
            <div class="feature-number">
              <%= String(index + 1).padStart(2, '0') %>
            </div>

            <h3><%= feature[0] %></h3>
            <p><%= feature[1] %></p>
          </div>

          <div class="feature-footer">
            <span class="owner">PIC: <%= feature[2] %></span>
            <a href="#" class="btn action-btn"><%= feature[3] %></a>
          </div>
        </div>
      <% }) %>
    </section>
  </main>
</body>
</html>